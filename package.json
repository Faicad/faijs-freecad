{
  "name": "@faicad/faijs-freecad",
  "version": "0.29.5",
  "description": "FCStd reader and .fai.js conversion pipeline for faijs - unpack, sketch parse/solve, feature translate, batch CLI",
  "keywords": [
    "faijs",
    "cad",
    "fcstd",
    "freecad",
    "converter"
  ],
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://gitcode.com/Faicad/faijs-freecad.git"
  },
  "homepage": "https://gitcode.com/Faicad/faijs-freecad",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "faijs-freecad-convert": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./convert": {
      "types": "./dist/convert.d.ts",
      "default": "./dist/convert.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "dependencies": {
    "@faicad/faijs-sketch": "^0.29.0",
    "@xmldom/xmldom": "^0.9.8"
  },
  "peerDependencies": {
    "@faicad/faijs": "^0.29.0",
    "occt-wasm": "^5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faicad/faijs": "^0.29.0",
    "@types/node": "^26.2.0",
    "@types/three": "^0.184.1",
    "acorn": "^8.18.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "occt-wasm": "^5.6.0",
    "three": "^0.186.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-import-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  }
}
